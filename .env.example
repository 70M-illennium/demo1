# Copy to .env before `docker compose up`. .env is gitignored.
# These are local-demo credentials - all "fares" on purpose, not production values.

# --- monitored MySQL (the "target", port 3306) ---
MYSQL_ADMIN=fares
USERNAME=fares
PWORD=fares

# --- the monitor's own history store (port 3307) ---
STORE_ROOT_PASSWORD=fares
STORE_USER=fares
STORE_PASSWORD=fares

# --- the one ADMIN account for non-GET /api/** endpoints ---
MONITOR_ADMIN_USERNAME=fares
MONITOR_ADMIN_PASSWORD=fares

# --- AI health-assessment agent (bonus, CLI-only for now) ---
# Default provider is Ollama (https://ollama.com) - self-hosted, no account, no API
# key, no quota. Only set these if you're not using the defaults (localhost:11434,
# qwen2.5:14b) already in application.properties.
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:14b
#
# To use a provider you already have an account with instead, set AI_PROVIDER to
# "openai" or "anthropic" plus that provider's key and model (check the provider's own
# docs for current model names/IDs - these change over time).
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
